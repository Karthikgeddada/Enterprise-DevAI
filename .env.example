# Copy to .env for local development. On Render/Vercel set these in the
# dashboard instead - never commit real keys.

# LLM provider for the agent pipeline: openrouter (default) | groq | ollama
LLM_PROVIDER=openrouter

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: any model id from https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: lock CORS to your Vercel frontend URL (comma-separated),
# or leave unset to allow all origins
# ALLOWED_ORIGIN=https://your-app.vercel.app
