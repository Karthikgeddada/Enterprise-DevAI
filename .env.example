# Copy to .env for local development. On Render/Vercel set these in the
# dashboard instead - never commit real keys.

# LLM provider for the agent pipeline: openrouter | gemini | groq | ollama
LLM_PROVIDER=gemini

# Gemini API key (https://aistudio.google.com/apikey) - get one free
GEMINI_API_KEY=your-gemini-key-here

# Optional: pick a Gemini model id (cheapest: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter API key (https://openrouter.ai/keys) - optional alternative provider
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: any model id from https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: lock CORS to your Vercel frontend URL (comma-separated),
# or leave unset to allow all origins
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Pipeline engine for /generate: custom (default, asyncio) or langgraph
# (StateGraph orchestration with conditional edges + coder retry)
# PIPELINE_ENGINE=langgraph

# Optional: when set, /generate and /download require this key
# (X-API-Key header, or ?api_key= for the ZIP link). Leave unset for an
# open demo. Note: a static frontend can't keep secrets - pair this with
# the rate limit below.
# API_KEY=change-me

# Rate limit for /generate: max calls per IP per window (sliding, in-memory,
# single-process). Defaults shown.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW=600
